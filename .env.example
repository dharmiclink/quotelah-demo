# Model credentials — copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ── Option A: IBM watsonx.ai (preferred for IBM hackathon) ──────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
# WATSONX_REGION=us-south          # default: us-south
# WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct  # default

# ── Option B: OpenAI ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini         # default

# ── No credentials ───────────────────────────────────────────────────────────
# If neither option is configured the app runs in Sample mode only.
# The UI clearly labels this — no silent fallback to sample data on live text.
